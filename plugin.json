{
  "name": "basecite-agent-discovery",
  "version": "1.0.0",
  "description": "Public discovery metadata for BaseCite agent and MCP integrations.",
  "homepage": "https://basecite.com/",
  "documentation": "https://basecite.com/agents.md",
  "mcp": {
    "server_card": "https://mcp.basecite.com/.well-known/mcp/server-card.json",
    "endpoint": "https://mcp.basecite.com/mcp"
  },
  "api": {
    "openapi": "https://api.basecite.com/openapi.json",
    "oauth_authorization_server": "https://api.basecite.com/.well-known/oauth-authorization-server"
  },
  "authentication": {
    "guide": "https://basecite.com/auth.md",
    "type": "oauth2"
  },
  "security": {
    "credentials_required_for_public_discovery": false,
    "never_store_customer_data": true
  }
}
